{
  "name": "ruleta-ark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ruleta de premios con temática de supervivencia para una tienda online (Cloudflare Workers + D1 + Brevo, todo en plan gratuito).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "hash-password": "node scripts/hash-password.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.164.0"
  }
}
