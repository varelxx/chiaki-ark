// Configuración de Cloudflare Workers (plan gratuito). Ver README para el despliegue paso a paso.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruleta-ark",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  // Sin dominio propio: se publica en https://ruleta-ark.<tu-subdominio>.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  // CSS, JS, fuentes e icono de public/ se incrustan en el Worker antes de empaquetar
  // (scripts/generar-estaticos.mjs) y se sirven con caché de un año y versión en la URL.
  "build": { "command": "node scripts/generar-estaticos.mjs", "watch_dir": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruleta-ark",
      // Creada con `npx wrangler d1 create ruleta-ark --jurisdiction eu` (datos guardados en la UE).
      // Si despliegas en otra cuenta, crea la tuya y pega aquí su id.
      "database_id": "55d296b3-225b-4d0f-832f-2c3e664f5e4b",
      "migrations_dir": "migrations"
    }
  ],
  // Cola de correos y mantenimiento diario. Usa 1 de los cron triggers gratuitos de la cuenta.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  // Conserva las variables añadidas en el panel de Cloudflare al volver a desplegar.
  "keep_vars": true,
  "vars": {
    // URL pública (si la dejas vacía, se aprende sola la primera vez que entras al panel).
    "URL_BASE": "https://ruleta-ark.varel-rewards.workers.dev",
    "TIENDA_NOMBRE": "Varel Rewards",
    "REMITENTE_NOMBRE": "Varel Rewards",
    "RESPONSABLE_PAIS": "ES",
    "ZONA_HORARIA": "Europe/Madrid"
    // Los datos personales NO van aquí (el repositorio es público). Añádelos en Cloudflare:
    // Workers & Pages → ruleta-ark → Settings → Variables and Secrets → Add (tipo Text):
    //   REMITENTE_EMAIL     remitente verificado en Brevo
    //   CONTACTO_EMAIL      correo de contacto y privacidad (sale en los textos legales)
    //   RESPONSABLE_NOMBRE  titular de la promoción (nombre o razón social)
    //   TIENDA_URL          (opcional) web de la tienda
  }
}
